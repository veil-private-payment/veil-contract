.DS_Store
node_modules/
dist/
target/
test_snapshots/
.env
.env.local
# Deployment manifests are evidence and belong in the repository. Only files
# that carry secrets stay out.
deployments/*.deploy.env
!deployments/*.deploy.env.example
# Local secret keys for scripts (never commit). Keep the folder + its README.
scripts/ts/account/*
!scripts/ts/account/.gitkeep
!scripts/ts/account/README.md
circuits/src/circomlib/
circuits/**/*.r1cs
circuits/**/*.sym
circuits/**/*.wasm
circuits/**/*_js/
*.log
coverage/
.turbo/
.vite/
